# =============================================================================
# Vademécum AI Local — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it is gitignored.

# --- Gemini AI ---
GEMINI_API_KEY="your-gemini-api-key"
MY_GEMINI_API_KEY=""

# --- Supabase (Server-side — Express backend) ---
SUPABASE_URL="https://yourproject.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Supabase (Client-side — Frontend via Vite) ---
# Variables prefixed with VITE_ are exposed to the browser.
VITE_SUPABASE_URL="https://yourproject.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# --- Professional Access Gate ---
# The key that healthcare professionals must enter to access the app.
VITE_ACCESS_KEY="your-access-key"
