rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Hardened Global Helpers
    // ===============================================================

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\s\\(\\),.]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isEmailVerified() { return request.auth.token.email_verified == true; }
    
    function isAdmin() {
      return isSignedIn() && 
        (request.auth.token.email == "rolando.pizarro.salas@gmail.com" && isEmailVerified());
    }

    // ===============================================================
    // Product Validation Blueprint
    // ===============================================================
    
    function isValidProduct(data) {
      return data.sku is string && data.sku.size() <= 100 &&
             data.nombre_comercial is string && data.nombre_comercial.size() > 0 && data.nombre_comercial.size() <= 200 &&
             (!('apto_embarazo' in data) || data.apto_embarazo is string) &&
             (!('apto_lactancia' in data) || data.apto_lactancia is string) &&
             (!('apto_pediatria' in data) || data.apto_pediatria is string) &&
             (!('apto_diabeticos' in data) || data.apto_diabeticos is string) &&
             (!('apto_hipertensos' in data) || data.apto_hipertensos is string) &&
             (!('apto_celiacos' in data) || data.apto_celiacos is string) &&
             (!('vectores' in data) || (data.vectores is list)) &&
             (!('skus_relacionados' in data) || (data.skus_relacionados is list)) &&
             (!('tags_ia' in data) || (data.tags_ia is list)) &&
             (!('categoria_principal' in data) || data.categoria_principal is string) &&
             (!('analisis_componentes' in data) || data.analisis_componentes is string) &&
             (!('anotaciones_componentes' in data) || data.anotaciones_componentes is map) &&
             (!('synergy_analyzed' in data) || data.synergy_analyzed is bool) &&
             (!('sugerencia_complementaria' in data) || data.sugerencia_complementaria is string) &&
             (!('last_synergy_analysis' in data) || data.last_synergy_analysis is number) &&
             (!('lock_uid' in data) || data.lock_uid is string) &&
             (!('lock_timestamp' in data) || data.lock_timestamp is number) &&
             (!('last_updated' in data) || data.last_updated is number) &&
             (!('is_verified' in data) || data.is_verified is bool);
    }

    // ===============================================================
    // Pending Task Validation Blueprint
    // ===============================================================

    function isValidPendingTask(data) {
      return data.id is string && data.id.size() <= 100 &&
             data.type is string &&
             data.payload is map &&
             data.timestamp is number;
    }

    // ===============================================================
    // Rule Definitions
    // ===============================================================

    match /{document=**} {
      allow read, write: if false;
    }

    match /products/{sku} {
      allow get: if isSignedIn() && isValidId(sku);
      allow list: if isSignedIn() && isEmailVerified();
      
      allow create: if isSignedIn() && isEmailVerified() && isValidId(sku) && isValidProduct(incoming()) && 
                       incoming().sku == sku;

      allow update: if isSignedIn() && isEmailVerified() && isValidId(sku) && isValidProduct(incoming()) &&
                       (isAdmin() || 
                        (incoming().sku == existing().sku && 
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'vectores', 'sugerencia_complementaria', 'skus_relacionados',
                           'synergy_analyzed', 'last_synergy_analysis', 'lock_uid', 'lock_timestamp',
                           'last_updated', 'is_verified', 'verified_at', 'verified_by', 'tags_ia', 'categoria_principal', 'analisis_componentes', 'anotaciones_componentes'
                         ])
                        )
                       );
      
      allow delete: if isAdmin();
    }

    match /pending_tasks/{taskId} {
      allow get, list: if isSignedIn() && isEmailVerified();
      allow create: if isSignedIn() && isEmailVerified() && isValidId(taskId) && isValidPendingTask(incoming());
      allow update, delete: if isAdmin();
    }
  }
}
