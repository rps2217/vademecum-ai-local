{
  "name": "vademecum-ai",
  "version": "2.0.0",
  "description": "PWA local-first para consultoras de farmacia con búsqueda semántica, sinergias y backup cifrado",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20", "pnpm": ">=9" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "knip": "knip",
    "size": "vite-bundle-visualizer",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zustand": "^5.0.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-devtools": "^5.59.0",
    "dexie": "^4.0.10",
    "dexie-react-hooks": "^1.1.7",
    "@xenova/transformers": "^2.17.2",
    "minisearch": "^7.1.0",
    "@orama/orama": "^3.0.0",
    "@orama/plugin-embeddings": "^3.0.0",
    "@orama/plugin-secure-proxy": "^3.0.0",
    "yjs": "^13.6.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.6",
    "comlink": "^4.4.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "bip39": "^3.1.0",
    "zod": "^3.23.8",
    "react-hook-form": "^7.53.0",
    "@hookform/resolvers": "^3.9.0",
    "lucide-react": "^0.460.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.0",
    "class-variance-authority": "^0.7.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-slot": "^1.1.0",
    "framer-motion": "^11.11.0",
    "cmdk": "^1.0.0",
    "sonner": "^1.7.0",
    "react-virtuoso": "^4.10.0",
    "react-hotkeys-hook": "^4.5.0",
    "nanoid": "^5.0.7",
    "date-fns": "^4.1.0",
    "fflate": "^0.8.2",
    "@supabase/supabase-js": "^2.45.0",
    "posthog-js": "^1.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "vite-plugin-pwa": "^0.20.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "vitest": "^2.1.0",
    "@vitest/ui": "^2.1.0",
    "@vitest/coverage-v8": "^2.1.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/user-event": "^14.5.0",
    "jsdom": "^25.0.0",
    "@playwright/test": "^1.48.0",
    "eslint": "^9.13.0",
    "@typescript-eslint/parser": "^8.10.0",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unicorn": "^56.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "knip": "^5.27.0",
    "vite-bundle-visualizer": "^1.2.0"
  }
}
